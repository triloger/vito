# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#
# Create keys at: https://www.okx.com/account/my-api
#
# Hard rules (see docs/okx-setup.md):
#   1. Use a dedicated SUB-ACCOUNT funded with only what you are willing to lose.
#   2. Permissions: Read + Trade.  WITHDRAW MUST REMAIN OFF.
#   3. Enable the IP allowlist.
#   4. Start with Read-only permission; add Trade only when promoting to live.
# ---------------------------------------------------------------------------

VITO_OKX_API_KEY=
VITO_OKX_API_SECRET=
VITO_OKX_API_PASSPHRASE=

# 1 = use OKX demo-trading keys instead of the live environment.
VITO_OKX_DEMO=0

# Execution mode. readonly -> paper -> live. Live additionally requires
# VITO_LIVE=1 and a matching policy digest confirmation.
VITO_MODE=readonly

# Required for live orders: set to 1 to arm the executor.
VITO_LIVE=0

# Optional: point Vito at a repo checkout other than the current directory.
# VITO_HOME=/home/you/vito
